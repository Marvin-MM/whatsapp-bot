# Copy to .env and fill in. `.env` is gitignored: never commit real values.
# Every variable is validated at startup (web and worker); a missing or invalid one exits naming it.
# Until you have a Meta app / Groq key / Telegram bot, any non-empty placeholder lets Phase 0 run.

# ---- Core -------------------------------------------------------------------
# NODE_ENV is set by Next and Docker. Leave it unset locally (the worker then logs pretty output).
# NODE_ENV=development
APP_URL=http://localhost:3000
# Runtime (application) role: DML only, append-only on audit_log. Created by scripts/db-init/01-roles.sql.
DATABASE_URL=postgres://wab_app:wab_app_dev@localhost:5432/wab
# Migration role: owns the schema and runs DDL. Used ONLY by `pnpm db:migrate`, never by the running app.
DATABASE_MIGRATION_URL=postgres://wab_migrator:wab_migrator_dev@localhost:5432/wab
# none | transaction (set `transaction` behind a PgBouncer-style transaction pooler: disables prepared statements)
DATABASE_POOLER=none
REDIS_URL=redis://localhost:6379/0
# Prefix for BullMQ keys and the realtime pub/sub channel. Keep it different per environment on a shared Redis.
BULLMQ_PREFIX=wab
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# IANA time zone name. Drives quiet hours, relative dates ("tomorrow 3pm") and the daily digest.
OWNER_TIMEZONE=Africa/Kampala

# ---- Auth (Better Auth) -----------------------------------------------------
# At least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# The single owner. `pnpm seed:owner` creates this account; no other account is ever accepted.
OWNER_EMAIL=

# ---- Meta / WhatsApp Cloud API ----------------------------------------------
# Graph API version. v26.0 (released 2026-07-29) was current when this file was written; Meta supports each
# version for at least two years. Check Meta's changelog before changing it.
META_GRAPH_VERSION=v26.0
META_APP_SECRET=
# Any random string; you paste the same value into the Meta webhook configuration.
WEBHOOK_VERIFY_TOKEN=
# A System User token (permanent). Dashboard "temporary" tokens expire in about 24 hours.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# ---- AI (Groq) --------------------------------------------------------------
GROQ_API_KEY=
# VERIFY these against Groq's current *production* models before use: Groq retires models every few months
# (llama-3.3-70b-versatile and llama-3.1-8b-instant were retired 2026-08-16). Strict JSON-schema decoding, which
# the structured calls rely on, exists only on the gpt-oss models and qwen3.8.
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
LLM_MODEL_DRAFT=openai/gpt-oss-120b
LLM_MODEL_ANALYSIS=openai/gpt-oss-120b
# A smaller, different model for the autopilot verifier: independent errors beat a second opinion from the same model.
LLM_MODEL_VERIFY=openai/gpt-oss-20b
# Base Whisper covers Swahili but NOT Luganda: Luganda voice notes are flagged low-confidence, never trusted.
LLM_MODEL_TRANSCRIBE=whisper-large-v3
TRANSCRIBE_AUDIO=true
# Quiet period (seconds) after the last inbound message before one draft answers the whole burst.
DRAFT_DEBOUNCE_SECONDS=25
# Autopilot eligibility threshold on normalized edit distance (Phase 7).
AUTOPILOT_MAX_EDIT_DISTANCE=0.30
# Optional: what your models cost, so Analytics can show a cost line (prices per million tokens, in your currency; look them up on Groq's
# pricing page: nothing here is a built-in price). Without it Analytics shows tokens only.
# AI_PRICE_PER_MTOK_JSON='{"currency":"USD","models":{"openai/gpt-oss-120b":{"input":0.15,"output":0.6}}}'

# ---- Media ------------------------------------------------------------------
MEDIA_STORAGE_DIR=./data/media

# ---- Telegram (notifications) -----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any random string; Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token so forged callbacks are rejected.
TELEGRAM_WEBHOOK_SECRET=
